# Local server port. The hosted HTTP function does not open a listening port.
PORT=54880
# Live viaSocket setup; keep the embed secret on the server.
VIASOCKET_ORG_ID=
VIASOCKET_PROJECT_ID=
VIASOCKET_EMBED_SECRET=
# Managed account setup. Publishable key only; the server rejects service-role keys here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only worker/database administration key. Never expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Exactly 32 random bytes encoded as base64, used to encrypt account sessions.
AUTH_SESSION_KEY=
APP_URL=http://localhost:54880
